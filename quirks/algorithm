#pragma once

namespace std {

template <typename T>
constexpr const T &min(const T &a, const T &b) { return b < a ? b : a; }
template <typename T>
constexpr const T &max(const T &a, const T &b) { return a < b ? b : a; }
template <typename T>
void swap(T &a, T &b) { T t = a; a = b; b = t; }
template <typename I, typename T>
I lower_bound(I first, I last, const T &value)
{
	for (int count = last - first; count > 0;) {
		int step = count / 2;
		if (first[step] < value) {
			first += step + 1;
			count -= step + 1;
		} else {
			count = step;
		}
	}
	return first;
}

}

